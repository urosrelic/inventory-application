<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Document</title>
    <link rel="stylesheet" href="/style.css"/>
</head>
<body>
<%- include('partials/nav') %>
<main class="items">
    <h1 class="items__category"><%= category.name %></h1>
    <% {items.map((item) => { %>
        <div class="item">
            <span class="item__name"><%= item.name %></span>
            <span class="item__description">
                <%= item.description %>
            </span>
            <a href="#" class="item__view-btn">View item</a>
        </div>
    <% })} %>
</body>
</html>
